# Keep true for an instant local UI demo. Change to false for live GCP data.
DEMO_MODE=true

GCP_PROJECT=mos-gcp-host-dev-prj
BQ_DATASET=dw_nsp_api_views
BQ_LOCATION=me-central2
BQ_EMBEDDINGS_TABLE=nsp_rag_embeddings_clean
EMBEDDING_MODEL=embeddinggemma-300m

# The current clean demo view stores vectors in embedding.result.
# Change to flat after switching to nsp_rag_embeddings_v2.
BQ_VECTOR_MODE=legacy_struct

# Gemini availability can differ from the BigQuery dataset location.
VERTEX_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash
TOP_K=8
FRONTEND_ORIGIN=http://localhost:5173

